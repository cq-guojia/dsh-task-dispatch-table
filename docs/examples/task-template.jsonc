// ═══════════════════════════════════════════════════════════════════════════
// 任务定义模板（全字段注释版）
//
// 用法与规矩：
//   1. 本文件是 jsonc（带注释）。粘进 Web 设置卡片 tasksInline 文本框前
//      必须删掉全部注释 —— 文本框只收【纯 JSON】，注释会导致解析失败。
//   2. 顶层是数组，每项一个任务定义；一个数组里可放多个任务。
//   3. 校验失败（字段缺失/格式错）的任务会在宿主日志告警并跳过，其余照常。
//   4. 实例状态全部落宿主 storages/dsh-task-dispatch-table/state.db
//      （task_instances / task_events 两表），任务定义本身不进数据库。
//   5. 启用任务的最简形态 = id + enabled + schedule(cron 或 once, window) +
//      target(workspace, prompt)；contract.validStatuses 有默认值，整段可省略。
// ═══════════════════════════════════════════════════════════════════════════
[
  {
    // ─────────────────────── 身份 ───────────────────────

    // 任务唯一标识。kebab-case：小写字母/数字、多段用 - 连接（image-upgrade-daily ✅，Image_Upgrade ❌）。
    // 实例在状态库的身份 = id + logical_date（计划时刻落在哪个日历日）：
    // 同一任务每天一条实例行，重试在该行内递增次数，永不因重试/补跑产生重复行。
    "id": "image-upgrade-daily",

    // false = 临时下线：不参与调度、不产生实例，定义保留。
    // 停一个任务改这里，别删定义。
    "enabled": true,

    // ─────────────────────── 调度时机：决定「什么时候该跑」 ───────────────────────
    "schedule": {
      // 标准 5 段 cron：分 时 日 月 周（cron-parser 5.x 语法）。
      // 加载时校验，写错整个任务被跳过并告警。
      // 调度器用它算出每个日历日的计划时刻 —— 即实例的「应到时间」。
      // ⚠ cron 与 once（见下）必须恰有其一：周期任务用 cron，一次性任务用 once。
      "cron": "0 9 * * *",

      // 一次性任务：在该时刻派发一次，跑完自动停（无需改 enabled）。
      // 格式 YYYY-MM-DDTHH:mm，按 timezone 的墙上时间解释（缺省 = 宿主时区）。
      // 原理：实例身份 = id + 该日期，只有一个日期 ⇒ 只有一条实例；
      // 跑到终态后行已存在、日期已过 ⇒ 不再生成实例，次年也不会再触发。
      // 适用：迁移、一次性巡检、定时备份一次等。
      // "once": "2026-10-01T14:30",

      // IANA 时区名（Asia/Shanghai / UTC / ...），加载时校验。省略 = 宿主时区。
      // 两个作用：① cron/once 的钟点在哪个时区解释；② logical date 的日界归属
      // （UTC 的 cron 在北京时间 08:00 起算新的一天）。
      // "timezone": "Asia/Shanghai",

      // 有效执行期，ISO 8601 时长（只支持时分秒：PT2H / PT30M / PT1H30M）。
      // 语义：窗口只管开始 —— 从计划时刻起这段时间内允许派发与重试。
      //   · 到点没派上（宿主重启等）→ 窗口内下个 tick 还会补派
      //   · 派了反复失败、窗口耗尽 → 实例 skipped，切次日新实例
      //   · 当日窗口内修复则继续（重试不会把你踢出窗口）
      //   · 链式任务的下游窗口必须与上游重叠，否则下游永远等不到上游完成
      "window": "PT4H"
    },

    // ─────────────────────── 派发目标：决定「在哪跑、派发时说什么」 ───────────────────────
    "target": {
      // 在哪个工作区执行：按工作区【标题】精确匹配（id 兜底），必须是宿主里真实存在的工作区。
      // 这里填的是【工作区】，不是目录——运行目录由工作区自己决定，你不用管。
      // 匹配不到 ⇒ 该实例判失败（决策 22），不会退化成「未分组」或随便找个目录跑。
      // agent 是独立完整会话（非子 agent），工作目录 = 该工作区根目录；
      // 下面的 manual 路径以这个根目录为基准。
      "workspace": "ops",

      // 执行模型：provider 与 model 必须【成对】填，只填一个视为没填（决策 22）。
      // 两者都省略 = 按漏斗下漏：插件配置 defaultProvider/defaultModel
      //   → 宿主默认模型（= 你上一次用的） → 宿主首个可用模型。一般留空即可。
      // 只填 model 时会在已注册 provider 里反查一次，查不到就继续往下漏。
      // "provider": "deepseek",
      // "model": "deepseek-chat",

      // 任务手册 MD 的路径（相对工作区根）。调度器把路径拼进派发消息，agent 主动去读。
      // 分层原则：长指令/详细步骤都写手册，prompt 只留一句话导读。
      // "manual": "manuals/image-upgrade-daily.md",

      // 派发消息主体。调度器实际发的消息 ≈ prompt + 手册路径指引 + 现成的回执提交命令。
      // ⚠ agent 看不到本任务定义 JSON —— 但回执命令（决策 19）由调度器拼好整条下发，
      //   agent 照着执行即可，无需你在 prompt 里交代回执格式。
      "prompt": "执行镜像升级日报任务，按手册完成。"
    },

    // ─────────────────────── 完成判定：调度器只认回执，不信 agent 自报 ───────────────────────
    // 整段可省略（省略 = validStatuses 默认 ["ok"]）。
    "contract": {
      // 回执机制（决策 19）：没有契约文件。agent 干完活后执行调度器在派发消息里
      // 【拼好的现成命令】，把回执直写插件状态库（state.db 的 task_events 表）：
      //   node <插件dist>/submit.js --db <state.db> --task <id> --date <logical_date>
      //        --session <sessionId> --status ok [--outputs 产出文件,逗号分隔] [--note 备注]
      // 命令行参数（--db/--task/--date/--session）调度器已填好，agent 只补
      // --status 与 --outputs（实际产出文件，相对工作区路径；无产出可省略整个参数）。
      //
      // 回执三查，全部通过才算成功：
      //   1. 存在【本次派发之后】提交的回执事件（防上一轮重试的旧回执冒充）
      //   2. 回执的 status ∈ validStatuses
      //   3. outputs 逐一存在且文件 mtime 晚于本次派发时刻（防旧产物冒充）
      // 跑完没交回执：宽限期后插件对原会话追问（重发回执命令，最多 2 次），
      // 仍无回执 = 失败 → 进 retry → 用尽 failed → 窗口耗尽 skipped。
      //
      // 回执 status 的合法值清单。省略 = ["ok"]。status 必须如实，
      // 失败的检查不得伪装成 ok；可定义多级状态如 ["ok", "partial"] ——
      // 算不算成功由你定，调度器只认清单。
      "validStatuses": ["ok"]
    },

    // ─────────────────────── 失败重试 ───────────────────────
    // 对账判失败后【当场】重新派发（同一工作区），次数记在同一实例行内递增，不建新行。
    // 用尽仍失败 → 实例 failed；下游任务全部跳过（失败向下游传播）；
    // 上游当天窗口内修复后，下游下个 tick 仍可活过来。省略 = 1（不重试）。整数 ≥1。
    "retry": { "maxAttempts": 2 },

    // ─────────────────────── 历史补跑（已删除） ───────────────────────
    // 原 backfill.days 字段已于决策 31.7 删除：**不回看、不补跑**——
    // 只判「现在这一刻该不该跑」，过去的刻度过了就是过了，不补建 skipped。
    // 想重跑历史：SQL 手动重置实例状态（见 state-machine §7 手动层）。

    // ─────────────────────── 依赖声明（整段可删） ───────────────────────
    // 【写在下游】—— 日报依赖清单，就写在日报的定义里，上游一无所知、不用改一行。
    // 多个依赖是 AND：全部满足才派发。别成环（互相等 = 永远不派）。
    "depends_on": [
      {
        // 上游任务的 id，必须与任务表里上游定义的 "id" 一字不差。
        "task": "inventory-daily",

        // 依赖语义，二选一：
        //
        // "same_period" —— 「同一天的才算数」：派发前查上游是否有【同一 logical date】
        //   的实例且状态 done。下游消费「今天这批」数据时用它
        //   （昨天的清单对今天的日报没有意义）。
        //   时间线：上游 running/pending → 下游等着（在窗口内，逐 tick 重查）；
        //           上游 failed/skipped 或当天无实例 → 下游不派，
        //           窗口耗尽后收敛为 skipped —— 宁可不做，不拿旧数据冒充今天。
        //
        // "latest_success" —— 「最近一次成功（不限哪天）」：上游是「数据变了就重跑」型、
        //   下游只要最近结果时用它。须配 freshness 限新鲜度，否则可能拿很久前的结果。
        //   例：{ "task": "db-snapshot", "semantics": "latest_success", "freshness": "PT20H" }
        "semantics": "same_period"

        // 新鲜度上限（ISO 时长，如 PT20H），仅 latest_success 有意义：
        // 最近一次成功距今超过它就不算数，下游保持 pending 等上游。
        // 启用时注意给上一行补逗号：
        // , "freshness": "PT20H"
      }
    ]
  },

  // ═══════════════════════════════════════════════════════════════════════
  // 一次性任务样例（决策 18）：schedule.once 指定唯一派发时刻，
  // 跑到终态（done/failed/skipped）后自动停，无需改 enabled、次年也不触发。
  // 与 cron 互斥（checkedTask 强校验）；其余字段语义与周期任务一致。
  // ═══════════════════════════════════════════════════════════════════════
  {
    "id": "db-migrate-once",
    "enabled": true,
    "schedule": {
      "once": "2026-10-01T14:30",   // 该日 14:30 派发一次
      "timezone": "Asia/Shanghai",   // 墙上时间按此时区解释；省略 = 宿主时区
      "window": "PT2H"               // 14:30–16:30 有效，过窗 skipped
    },
    "target": {
      "workspace": "ops",
      "prompt": "执行 DB 迁移 v2，按手册完成。"
    }
    // contract 整段省略 = validStatuses 取默认 ["ok"]；
    // 回执提交命令由调度器拼进派发消息（决策 19），无需在此配置。
  }
]
